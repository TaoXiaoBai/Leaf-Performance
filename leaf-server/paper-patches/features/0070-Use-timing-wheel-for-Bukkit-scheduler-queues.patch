         parsePending();
-        while (!this.pending.isEmpty() && this.pending.peek().getNextRun() <= currentTick) {
-            CraftTask task = this.pending.remove();
-            if (executeTask(task)) {
-                final long period = task.getPeriod();
-                if (period > 0) {
-                    task.setNextRun(currentTick + period);
-                    temp.add(task);
+        while (true) {
+            final List<CraftTask> tasks = this.pending.popValid(currentTick);
+            if (tasks.isEmpty()) break;
+
+            for (final CraftTask task : tasks) {
+                if (executeTask(task)) {
+                    final long period = task.getPeriod();
+                    if (period > 0) {
+                        task.setNextRun(currentTick + period);
+                        temp.add(task);
+                    }
                 }
             }
+
             parsePending();
         }
-        this.pending.addAll(temp);
+
+        this.pending.addAll(temp, currentTick);
         temp.clear();
     }
 

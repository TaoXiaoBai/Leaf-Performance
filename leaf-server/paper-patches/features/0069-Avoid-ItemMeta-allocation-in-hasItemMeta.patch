From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leaf Performance experiments <noreply@localhost>
Date: Sat, 12 Sep 2026 00:35:00 +0800
Subject: [PATCH] Avoid ItemMeta allocation in CraftItemStack.hasItemMeta

Preserve legacy durability semantics while checking the component patch
directly instead of constructing and comparing a CraftMetaItem on every
hasItemMeta call.

Source: Paper PR #13928 by MelodyYuuka, head e265e632818c0c7cacc05081592f7fa575b48124.
License: GPL-3.0 under Paper contribution terms; attribution retained.
Status: experimental; compatibility audit deferred.

---
 .../craftbukkit/inventory/CraftItemStack.java | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/CraftItemStack.java b/src/main/java/org/bukkit/craftbukkit/inventory/CraftItemStack.java
--- a/src/main/java/org/bukkit/craftbukkit/inventory/CraftItemStack.java
+++ b/src/main/java/org/bukkit/craftbukkit/inventory/CraftItemStack.java
@@ -556,7 +556,7 @@ public final class CraftItemStack extends ItemStack {
 
     @Override
     public boolean hasItemMeta() {
-        return CraftItemStack.hasItemMeta(this.handle) && !CraftItemFactory.instance().equals(this.getItemMeta(), null);
+        return CraftItemStack.hasItemMeta(this.handle) && (this.handle.getDamageValue() != 0 || this.handle.getComponentsPatch().size() >= (this.handle.getComponentsPatch().get(DataComponentMap.EMPTY, CraftMetaItem.DAMAGE.TYPE) != null ? 2 : 1)); // Leaf-Performance - avoid ItemMeta allocation
     }
 
     static boolean hasItemMeta(net.minecraft.world.item.ItemStack item) {

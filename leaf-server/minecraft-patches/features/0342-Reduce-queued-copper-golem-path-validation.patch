From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leaf Performance experiments <noreply@localhost>
Date: Thu, 12 Sep 2026 01:30:00 +0800
Subject: [PATCH] Reduce queued copper golem path validation

Source: Paper PR #13077 by Jason Penilla <11360596+jpenilla@users.noreply.github.com>.
Fixed head: 077c6b1bcbb9cfd1ec1391e760af21d955f61856
Original project: PaperMC/Paper
License: GPL-3.0-only under Paper contribution terms.

Queued copper golems retain cheap target validity checks every tick but only
create a replacement path every 60 ticks. Travelling and interacting states
continue to perform full validation before acting.
diff --git a/net/minecraft/world/entity/ai/behavior/TransportItemsBetweenContainers.java b/net/minecraft/world/entity/ai/behavior/TransportItemsBetweenContainers.java
index 2243b8c6..1184f76d 100644
--- a/net/minecraft/world/entity/ai/behavior/TransportItemsBetweenContainers.java
+++ b/net/minecraft/world/entity/ai/behavior/TransportItemsBetweenContainers.java
@@ -120,26 +120,44 @@ public class TransportItemsBetweenContainers extends Behavior<PathfinderMob> {
 
     @Override
     protected void tick(final ServerLevel level, final PathfinderMob body, final long timestamp) {
-        boolean updatedInvalidTarget = this.updateInvalidTarget(level, body);
+        // Leaf-Performance start - Paper PR #13077 - avoid full queued path validation every tick
+        boolean invalidTarget = false;
+        boolean didFullCheck = false;
+        if (this.target == null) {
+            invalidTarget = this.updateInvalidTarget(level, body, true);
+            didFullCheck = true;
+        }
         if (this.target == null) {
             this.stop(level, body, timestamp);
-        } else if (!updatedInvalidTarget) {
-            if (this.state.equals(TransportItemsBetweenContainers.TransportItemState.QUEUING)) {
+        } else if (!invalidTarget) {
+            if (!didFullCheck) {
+                if (body.tickCount % 60 == 0) {
+                    invalidTarget = this.updateInvalidTarget(level, body, true);
+                    didFullCheck = true;
+                } else {
+                    invalidTarget = this.updateInvalidTarget(level, body, false);
+                }
+            }
+            if (!invalidTarget && this.state.equals(TransportItemsBetweenContainers.TransportItemState.QUEUING)) {
                 this.onQueuingForTarget(this.target, level, body);
             }
+            if (!invalidTarget && !this.state.equals(TransportItemsBetweenContainers.TransportItemState.QUEUING) && !didFullCheck) {
+                invalidTarget = this.updateInvalidTarget(level, body, true);
+            }
 
-            if (this.state.equals(TransportItemsBetweenContainers.TransportItemState.TRAVELLING)) {
+            if (!invalidTarget && this.state.equals(TransportItemsBetweenContainers.TransportItemState.TRAVELLING)) {
                 this.onTravelToTarget(this.target, level, body);
             }
 
-            if (this.state.equals(TransportItemsBetweenContainers.TransportItemState.INTERACTING)) {
+            if (!invalidTarget && this.state.equals(TransportItemsBetweenContainers.TransportItemState.INTERACTING)) {
                 this.onReachedTarget(this.target, level, body);
             }
         }
+        // Leaf-Performance end - Paper PR #13077
     }
 
-    private boolean updateInvalidTarget(final ServerLevel level, final PathfinderMob body) {
-        if (!this.hasValidTarget(level, body)) {
+    private boolean updateInvalidTarget(final ServerLevel level, final PathfinderMob body, final boolean createPath) {
+        if (!this.hasValidTarget(level, body, createPath)) {
             this.stopTargetingCurrentTarget(body);
             Optional<TransportItemsBetweenContainers.TransportItemTarget> targetBlockPosition = this.getTransportTarget(level, body);
             if (targetBlockPosition.isPresent()) {
@@ -340,13 +358,16 @@ public class TransportItemsBetweenContainers extends Behavior<PathfinderMob> {
         return transportItemTarget.blockEntity instanceof BaseContainerBlockEntity blockEntity && blockEntity.isLocked();
     }
 
-    private boolean hasValidTarget(final Level level, final PathfinderMob body) {
+    private boolean hasValidTarget(final Level level, final PathfinderMob body, final boolean createPath) {
         boolean targetIsOfValidType = this.target != null && this.isWantedBlock(body, this.target.state) && this.targetHasNotChanged(level, this.target);
         if (targetIsOfValidType && !this.isTargetBlocked(level, this.target)) {
             if (!this.state.equals(TransportItemsBetweenContainers.TransportItemState.TRAVELLING)) {
                 return true;
             }
 
+            if (!createPath && body.getNavigation().getPath() == null) {
+                return true;
+            }
             if (this.hasValidTravellingPath(level, this.target, body)) {
                 return true;
             }

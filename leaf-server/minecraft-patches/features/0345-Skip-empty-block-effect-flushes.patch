From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leaf Performance experiments <noreply@localhost>
Date: Mon, 14 Sep 2026 07:00:00 +0800
Subject: [PATCH] Skip empty block-effect collector flushes

Avoid scanning every InsideBlockEffectType when an entity crossed blocks but no
block or fluid recorded a deferred effect. EntityInsideBlockEvent dispatch and
all entityInside/onInsideBlock callbacks remain unchanged.

Source inspiration: Lithium 26.1.x entity.collisions.block_effects,
2No2Name, revision 701fb2e7636c6d634c76380c11232d27fd578dff.
License: LGPL-3.0-only; independently adapted to current Leaf 26.2.

diff --git a/net/minecraft/world/entity/InsideBlockEffectApplier.java b/net/minecraft/world/entity/InsideBlockEffectApplier.java
index 149e2a1..55149ce 100644
--- a/net/minecraft/world/entity/InsideBlockEffectApplier.java
+++ b/net/minecraft/world/entity/InsideBlockEffectApplier.java
@@ -38,6 +38,7 @@ public interface InsideBlockEffectApplier {
         private final List<Consumer<Entity>>[] afterEffectsInStep = new List[APPLY_ORDER.length];
         private final it.unimi.dsi.fastutil.objects.ObjectArrayList<Consumer<Entity>> finalEffects = new it.unimi.dsi.fastutil.objects.ObjectArrayList<>();
         private int lastStep = -1;
+        private boolean hasEffectsInStep;
 
         public StepBasedCollector() {
             for (int i = 0; i < APPLY_ORDER.length; i++) {
@@ -49,11 +50,18 @@ public interface InsideBlockEffectApplier {
             this.currentBlockPos = pos; // Paper - track position inside effect was triggered on
             if (this.lastStep != step) {
                 this.lastStep = step;
-                this.flushStep();
+                if (this.hasEffectsInStep) {
+                    this.flushStep();
+                }
             }
         }
 
         public void applyAndClear(final Entity entity) {
+            if (!this.hasEffectsInStep && this.finalEffects.isEmpty()) {
+                this.lastStep = -1;
+                return;
+            }
+
             this.flushStep();
 
             it.unimi.dsi.fastutil.objects.ObjectArrayList<Consumer<Entity>> effects = this.finalEffects;
@@ -71,6 +79,10 @@ public interface InsideBlockEffectApplier {
         }
 
         private void flushStep() {
+            if (!this.hasEffectsInStep) {
+                return;
+            }
+
             final int len = APPLY_ORDER.length;
             final List<Consumer<Entity>>[] beforeArr = this.beforeEffectsInStep;
             final Consumer<Entity>[] effectArr = this.effectsInStep;
@@ -99,20 +111,29 @@ public interface InsideBlockEffectApplier {
                     afterEffects.clear();
                 }
             }
+
+            this.hasEffectsInStep = false;
+        }
+
+        private void recordEffect() {
+            this.hasEffectsInStep = true;
         }
 
         @Override
         public void apply(final InsideBlockEffectType type) {
+            this.recordEffect();
             effectsInStep[type.ordinal()] = recorded(type);
         }
 
         @Override
         public void runBefore(final InsideBlockEffectType type, final Consumer<Entity> effect) {
+            this.recordEffect();
             beforeEffectsInStep[type.ordinal()].add(effect);
         }
 
         @Override
         public void runAfter(final InsideBlockEffectType type, final Consumer<Entity> effect) {
+            this.recordEffect();
             afterEffectsInStep[type.ordinal()].add(effect);
         }
         // Leaf end - optimize checkInsideBlocks calls

 import net.minecraft.world.level.storage.ValueInput;
 import net.minecraft.world.level.storage.ValueOutput;
 
@@ -617,6 +619,24 @@ public class Inventory implements Container, Nameable {
         return false;
     }
 
+    // Leaf-Performance start - avoid allocating map match predicates in MapItemSavedData
+    public boolean containsMap(final Item mapItem, final MapId mapId) {
+        for (int i = 0, size = this.items.size(); i < size; i++) {
+            final ItemStack stack = this.items.get(i);
+            if (stack.is(mapItem) && Objects.equals(mapId, stack.get(DataComponents.MAP_ID))) {
+                return true;
+            }
+        }
+        for (final EquipmentSlot slot : EQUIPMENT_SLOTS_SORTED_BY_INDEX) {
+            final ItemStack stack = this.equipment.get(slot);
+            if (stack.is(mapItem) && Objects.equals(mapId, stack.get(DataComponents.MAP_ID))) {
+                return true;
+            }
+        }
+        return false;
+    }
+    // Leaf-Performance end - avoid allocating map match predicates in MapItemSavedData
+

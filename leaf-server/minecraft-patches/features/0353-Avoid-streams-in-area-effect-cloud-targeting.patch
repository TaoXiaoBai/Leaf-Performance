From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leaf Performance experiments <noreply@localhost>
Date: Mon, 14 Sep 2026 08:04:50 +0800
Subject: [PATCH] Avoid streams in area-effect cloud targeting

Use a direct effect loop with the same encounter order and short-circuit behavior when selecting affected entities, and compute the selection radius square once per application tick.

diff --git a/net/minecraft/world/entity/AreaEffectCloud.java b/net/minecraft/world/entity/AreaEffectCloud.java
index f03fa06c0ba56f7f5e1e45bc1568a490751efde3..85d033f8b48cc83e31e5b54d626394b6f6fdc422 100644
--- a/net/minecraft/world/entity/AreaEffectCloud.java
+++ b/net/minecraft/world/entity/AreaEffectCloud.java
@@ -228,17 +228,31 @@ public class AreaEffectCloud extends Entity implements TraceableEntity {
                         this.potionContents.forEachEffect(allEffects::add, this.potionDurationScale);
                         List<LivingEntity> entities = this.level().getEntitiesOfClass(LivingEntity.class, this.getBoundingBox());
                         if (!entities.isEmpty()) {
+                            float radiusSqr = radius * radius;
                             List<org.bukkit.entity.LivingEntity> bukkitEntities = new java.util.ArrayList<>(); // CraftBukkit
                             for (LivingEntity entity : entities) {
-                                if (!this.victims.containsKey(entity) && entity.isAffectedByPotions() && !allEffects.stream().noneMatch(entity::canBeAffected)) {
-                                    double xd = entity.getX() - this.getX();
-                                    double zd = entity.getZ() - this.getZ();
-                                    double dist = xd * xd + zd * zd;
-                                    if (dist <= radius * radius) {
-                                        // CraftBukkit start
-                                        bukkitEntities.add((org.bukkit.entity.LivingEntity) entity.getBukkitEntity());
+                                if (this.victims.containsKey(entity) || !entity.isAffectedByPotions()) {
+                                    continue;
+                                }
+
+                                boolean canBeAffected = false;
+                                for (MobEffectInstance effect : allEffects) {
+                                    if (entity.canBeAffected(effect)) {
+                                        canBeAffected = true;
+                                        break;
                                     }
                                 }
+                                if (!canBeAffected) {
+                                    continue;
+                                }
+
+                                double xd = entity.getX() - this.getX();
+                                double zd = entity.getZ() - this.getZ();
+                                double dist = xd * xd + zd * zd;
+                                if (dist <= radiusSqr) {
+                                    // CraftBukkit start
+                                    bukkitEntities.add((org.bukkit.entity.LivingEntity) entity.getBukkitEntity());
+                                }
                             }
                             org.bukkit.event.entity.AreaEffectCloudApplyEvent event = org.bukkit.craftbukkit.event.CraftEventFactory.callAreaEffectCloudApplyEvent(this, bukkitEntities);
                             if (!event.isCancelled()) {

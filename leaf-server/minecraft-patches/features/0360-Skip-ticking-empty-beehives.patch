From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tao Xiaobai <1599170798@qq.com>
Date: Fri, 2 Oct 2026 16:51:47 +0800
Subject: [PATCH] Skip ticking empty beehives
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Empty beehives cannot release occupants or play work sounds, so return before entering the occupant loop.

Adapted from Gale PR #204 by Ömer (Nrleryxx), commit a17088ab. Gale patch/code license: GPL-3.0.

diff --git a/net/minecraft/world/level/block/entity/BeehiveBlockEntity.java b/net/minecraft/world/level/block/entity/BeehiveBlockEntity.java
index 03182f3c261c6ddffcbc322f1b782499b4673cfa..212ca9359e27423381891e436050e7a9ab54d289 100644
--- a/net/minecraft/world/level/block/entity/BeehiveBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/BeehiveBlockEntity.java
@@ -357,8 +357,9 @@ public class BeehiveBlockEntity extends BlockEntity {
     }
 
     public static void serverTick(final Level level, final BlockPos blockPos, final BlockState state, final BeehiveBlockEntity entity) {
+        if (entity.stored.isEmpty()) return; // Gale - Nrleryxx - skip ticking empty beehives
         tickOccupants(level, blockPos, state, entity.stored, entity.savedFlowerPos);
-        if (!entity.stored.isEmpty() && level.getRandom().nextDouble() < 0.005) {
+        if (level.getRandom().nextDouble() < 0.005) {
             double x = blockPos.getX() + 0.5;
             double y = blockPos.getY();
             double z = blockPos.getZ() + 0.5;

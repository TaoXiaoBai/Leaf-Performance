From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leaf Performance experiments <noreply@localhost>
Date: Sat, 12 Sep 2026 01:00:00 +0800
Subject: [PATCH] Skip unused vehicle update and move events

Avoid allocating vehicle update/move events, and avoid minecart Location
wrappers, when no plugin listens to those event types. Dynamic listener checks
remain per tick and listener-present behavior remains unchanged.

Source: Paper PR #14173 by flennium, commit 947bb910.
License: GPL-3.0; attribution retained per Paper contribution terms.
Status: experimental; plugin compatibility audit deferred.

---
 2 files changed
diff --git a/net/minecraft/world/entity/vehicle/boat/AbstractBoat.java b/net/minecraft/world/entity/vehicle/boat/AbstractBoat.java
index ad7b39f3..d67f6833 100644
--- a/net/minecraft/world/entity/vehicle/boat/AbstractBoat.java
+++ b/net/minecraft/world/entity/vehicle/boat/AbstractBoat.java
@@ -275,14 +275,21 @@ public abstract class AbstractBoat extends VehicleEntity implements Leashable {
         }
 
         // CraftBukkit start
-        org.bukkit.Location to = org.bukkit.craftbukkit.util.CraftLocation.toBukkit(this.position(), this.level(), this.getYRot(), this.getXRot());
+        final boolean hasUpdateListeners = org.bukkit.event.vehicle.VehicleUpdateEvent.getHandlerList().getRegisteredListeners().length != 0;
+        boolean hasMoveListeners = org.bukkit.event.vehicle.VehicleMoveEvent.getHandlerList().getRegisteredListeners().length != 0;
+        // Capture before VehicleUpdateEvent: its handlers may move the boat or change VehicleMoveEvent registration.
+        org.bukkit.Location to = hasUpdateListeners || hasMoveListeners
+            ? org.bukkit.craftbukkit.util.CraftLocation.toBukkit(this.position(), this.level(), this.getYRot(), this.getXRot())
+            : null;
         org.bukkit.entity.Vehicle vehicle = (org.bukkit.entity.Vehicle) this.getBukkitEntity();
 
-        new org.bukkit.event.vehicle.VehicleUpdateEvent(vehicle).callEvent();
+        if (hasUpdateListeners) {
+            new org.bukkit.event.vehicle.VehicleUpdateEvent(vehicle).callEvent();
+            hasMoveListeners = org.bukkit.event.vehicle.VehicleMoveEvent.getHandlerList().getRegisteredListeners().length != 0;
+        }
 
-        if (this.lastLocation != null && !this.lastLocation.equals(to)) {
-            org.bukkit.event.vehicle.VehicleMoveEvent event = new org.bukkit.event.vehicle.VehicleMoveEvent(vehicle, this.lastLocation, to);
-            event.callEvent();
+        if (hasMoveListeners && this.lastLocation != null && !this.lastLocation.equals(to)) {
+            new org.bukkit.event.vehicle.VehicleMoveEvent(vehicle, this.lastLocation, to).callEvent();
         }
         this.lastLocation = vehicle.getLocation();
         // CraftBukkit end

diff --git a/net/minecraft/world/entity/vehicle/minecart/AbstractMinecart.java b/net/minecraft/world/entity/vehicle/minecart/AbstractMinecart.java
index 03e029e9..f2a76486 100644
--- a/net/minecraft/world/entity/vehicle/minecart/AbstractMinecart.java
+++ b/net/minecraft/world/entity/vehicle/minecart/AbstractMinecart.java
@@ -328,15 +328,22 @@ public abstract class AbstractMinecart extends VehicleEntity {
         // this.handlePortal(); // CraftBukkit - handled in postTick
         this.behavior.tick();
         // CraftBukkit start
-        org.bukkit.World bworld = this.level().getWorld();
-        org.bukkit.Location from = new org.bukkit.Location(bworld, prevX, prevY, prevZ, prevYaw, prevPitch);
-        org.bukkit.Location to = org.bukkit.craftbukkit.util.CraftLocation.toBukkit(this.position(), this.level(), this.getYRot(), this.getXRot());
-        org.bukkit.entity.Vehicle vehicle = (org.bukkit.entity.Vehicle) this.getBukkitEntity();
-
-        new org.bukkit.event.vehicle.VehicleUpdateEvent(vehicle).callEvent();
+        final boolean hasUpdateListeners = org.bukkit.event.vehicle.VehicleUpdateEvent.getHandlerList().getRegisteredListeners().length != 0;
+        boolean hasMoveListeners = org.bukkit.event.vehicle.VehicleMoveEvent.getHandlerList().getRegisteredListeners().length != 0;
+        if (hasUpdateListeners || hasMoveListeners) {
+            org.bukkit.World bworld = this.level().getWorld();
+            org.bukkit.Location from = new org.bukkit.Location(bworld, prevX, prevY, prevZ, prevYaw, prevPitch);
+            org.bukkit.Location to = org.bukkit.craftbukkit.util.CraftLocation.toBukkit(this.position(), this.level(), this.getYRot(), this.getXRot());
+            org.bukkit.entity.Vehicle vehicle = (org.bukkit.entity.Vehicle) this.getBukkitEntity();
+
+            if (hasUpdateListeners) {
+                new org.bukkit.event.vehicle.VehicleUpdateEvent(vehicle).callEvent();
+                hasMoveListeners = org.bukkit.event.vehicle.VehicleMoveEvent.getHandlerList().getRegisteredListeners().length != 0;
+            }
 
-        if (!from.equals(to)) {
-            new org.bukkit.event.vehicle.VehicleMoveEvent(vehicle, from, to).callEvent();
+            if (hasMoveListeners && !from.equals(to)) {
+                new org.bukkit.event.vehicle.VehicleMoveEvent(vehicle, from, to).callEvent();
+            }
         }
         // CraftBukkit end
         this.updateFluidInteraction();

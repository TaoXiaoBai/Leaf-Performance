From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tao Xiaobai <1599170798@qq.com>
Date: Thu, 15 Oct 2026 22:26:55 +0800
Subject: [PATCH] Bound spawner nearby query at the live cap

---
 net/minecraft/world/level/BaseSpawner.java | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/net/minecraft/world/level/BaseSpawner.java b/net/minecraft/world/level/BaseSpawner.java
index a9582ed..90c14fe 100644
--- a/net/minecraft/world/level/BaseSpawner.java
+++ b/net/minecraft/world/level/BaseSpawner.java
@@ -227,13 +227,16 @@ public abstract class BaseSpawner {
                                 nearbyEntitiesRange = this.spawnRange;
                                 nearbyEntitiesBox = new AABB(pos.getX(), pos.getY(), pos.getZ(), pos.getX() + 1, pos.getY() + 1, pos.getZ() + 1).inflate(nearbyEntitiesRange); // Gale - Nrleryxx
                             }
-                            int nearBy = level.getEntities(
-                                    EntityTypeTest.forExactClass(entity.getClass()),
-                                    nearbyEntitiesBox,
-                                    EntitySelector.NO_SPECTATORS
-                                )
-                                .size();
-                            if (nearBy >= this.maxNearbyEntities) {
+                            // Leaf start - Bound the existing exact-class query at the live nearby cap
+                            java.util.List<Entity> nearbyEntities = new java.util.ArrayList<>();
+                            level.getEntities(
+                                EntityTypeTest.forExactClass(entity.getClass()),
+                                nearbyEntitiesBox,
+                                EntitySelector.NO_SPECTATORS,
+                                nearbyEntities,
+                                this.maxNearbyEntities
+                            );
+                            if (nearbyEntities.size() >= this.maxNearbyEntities) { // Leaf end - Bound the existing exact-class query at the live nearby cap
                                 this.delay(level, pos);
                                 return;
                             }

@@ -337,6 +340,37 @@ public class SimpleBitStorage implements BitStorage {
         // Paper end - optimise bitstorage read/write operations
     }
 
+    // Leaf start - Lithium - optimize chunk palette serialization
+    @Override
+    public <T> void lithium$compact(final Palette<T> sourcePalette, final Palette<T> destinationPalette, final short[] output) {
+        if (this.size != output.length) {
+            throw new IllegalStateException("Array size mismatch");
+        }
+
+        final PaletteResize<T> noResizeExpected = PaletteResize.noResizeExpected();
+        final short[] mappings = new short[(int)(this.mask + 1L)];
+        int outputIndex = 0;
+
+        for (final long packedWord : this.data) {
+            long remaining = packedWord;
+            for (int elementIndex = 0; elementIndex < this.valuesPerLong; elementIndex++) {
+                final int value = (int)(remaining & this.mask);
+                int remappedId = mappings[value];
+                if (remappedId == 0) {
+                    remappedId = destinationPalette.idFor(sourcePalette.valueFor(value), noResizeExpected) + 1;
+                    mappings[value] = (short)remappedId;
+                }
+
+                output[outputIndex++] = (short)(remappedId - 1);
+                if (outputIndex >= this.size) {
+                    return;
+                }
+                remaining >>>= this.bits;
+            }
+        }
+    }
+    // Leaf end - Lithium - optimize chunk palette serialization
+
     @Override
     public long[] getRaw() {
         return this.data;


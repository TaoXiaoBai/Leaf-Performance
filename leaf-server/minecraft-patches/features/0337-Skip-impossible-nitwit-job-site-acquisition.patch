From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leaf Performance experiments <noreply@localhost>
Date: Sat, 12 Sep 2026 00:40:00 +0800
Subject: [PATCH] Skip impossible nitwit job-site acquisition

Nitwits use the always-false job-site predicate. Do not install the priority-6
job-site AcquirePoi behavior for that profession, avoiding repeated POI search
work while leaving home and meeting-point acquisition intact.

Inspired by Lithium PR #718 (LGPL-3.0); independently adapted for Leaf 26.2.
Status: experimental; Brain scheduling and plugin compatibility audit deferred.

---
 net/minecraft/world/entity/ai/behavior/VillagerGoalPackages.java | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)
diff --git a/net/minecraft/world/entity/ai/behavior/VillagerGoalPackages.java b/net/minecraft/world/entity/ai/behavior/VillagerGoalPackages.java
index bcae1ac0..3cb107cd 100644
--- a/net/minecraft/world/entity/ai/behavior/VillagerGoalPackages.java
+++ b/net/minecraft/world/entity/ai/behavior/VillagerGoalPackages.java
@@ -32,7 +32,9 @@ public class VillagerGoalPackages {
     public static ImmutableList<Pair<Integer, ? extends BehaviorControl<? super Villager>>> getCorePackage(
         final Holder<VillagerProfession> profession, final float speedModifier
     ) {
-        return ImmutableList.of(
+        // Leaf-Performance start - avoid impossible nitwit job-site acquisition work
+        ImmutableList.Builder<Pair<Integer, ? extends BehaviorControl<? super Villager>>> builder = ImmutableList.builder();
+        builder.add(
             Pair.of(0, new Swim<>(0.8F)),
             Pair.of(0, InteractWithDoor.create()),
             Pair.of(0, new LookAtTargetSink(45, 90)),
@@ -45,8 +47,10 @@ public class VillagerGoalPackages {
             Pair.of(1, new MoveToTargetSink()),
             Pair.of(2, PoiCompetitorScan.create()),
             Pair.of(3, new LookAndFollowTradingPlayerSink(speedModifier)),
-            Pair.of(5, GoToWantedItem.create(villager -> !villager.isSleeping(), speedModifier, false, 4)), // Paper - Fix MC-157464
-            Pair.of(
+            Pair.of(5, GoToWantedItem.create(villager -> !villager.isSleeping(), speedModifier, false, 4)) // Paper - Fix MC-157464
+        );
+        if (!profession.is(VillagerProfession.NITWIT)) {
+            builder.add(Pair.of(
                 6,
                 AcquirePoi.create(
                     profession.value().acquirableJobSite(),
@@ -56,7 +60,9 @@ public class VillagerGoalPackages {
                     Optional.empty(),
                     (l, p) -> true
                 )
-            ),
+            ));
+        }
+        builder.add(
             Pair.of(7, new GoToPotentialJobSite(speedModifier)),
             Pair.of(8, YieldJobSite.create(speedModifier)),
             Pair.of(10, AcquirePoi.create(p -> p.is(PoiTypes.HOME), MemoryModuleType.HOME, false, Optional.of((byte)14), VillagerGoalPackages::validateBedPoi)),
@@ -64,6 +70,8 @@ public class VillagerGoalPackages {
             Pair.of(10, AssignProfessionFromJobSite.create()),
             Pair.of(10, ResetProfession.create())
         );
+        return builder.build();
+        // Leaf-Performance end - avoid impossible nitwit job-site acquisition work
     }
 
     private static boolean validateBedPoi(final ServerLevel level, final BlockPos blockPos) {
